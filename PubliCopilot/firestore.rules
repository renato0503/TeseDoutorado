rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdminByClaim() { return isAuthenticated() && request.auth.token.admin == true; }
    function isAdminByDoc() { return isAuthenticated() && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.papel == 'admin'; }
    function isAdmin() { return isAdminByClaim() || isAdminByDoc(); }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /analises/{userId}/{document=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow delete: if isAdmin();
    }

    match /editais/{editalId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.usuarioId) || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.usuarioId) || isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /base_conhecimento/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /estatisticas/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
